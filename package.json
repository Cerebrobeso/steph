{
  "name": "steph",
  "version": "0.0.2",
  "scripts": {
    "Patch release (1.0.0 --> 1.0.1)": "npm run release -- --release-as patch",
    "Minor release (1.0.0 --> 1.1.0)": "npm run release -- --release-as minor",
    "Major release (1.0.0 --> 2.0.0)": "npm run release -- --release-as major",
    "ng": "ng",
    "release": "commit-and-tag-version",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/prod/server/server.mjs",
    "build:github": "ng build --configuration production",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-server": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/flag-icons": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@ng-icons/simple-icons": "^36.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@spartan-ng/brain": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "express": "^5.1.0",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.4",
    "angular-eslint": "22.5.0",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
